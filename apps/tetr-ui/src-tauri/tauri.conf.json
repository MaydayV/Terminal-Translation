{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tetr-ui",
  "version": "0.1.0",
  "identifier": "com.colin.tetr",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ dev",
    "beforeBuildCommand": "pnpm --dir ../ build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tetr",
        "width": 980,
        "height": 300,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true
      }
    ]
  }
}
