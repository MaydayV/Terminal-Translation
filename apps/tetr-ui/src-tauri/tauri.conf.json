{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tetr-ui",
  "version": "0.1.9",
  "identifier": "com.colin.tetr",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ dev",
    "beforeBuildCommand": "pnpm --dir ../ build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tetr 翻译",
        "width": 980,
        "height": 260,
        "minWidth": 420,
        "minHeight": 180,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": true
      }
    ]
  }
}
